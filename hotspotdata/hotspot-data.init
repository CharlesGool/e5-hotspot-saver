#!/bin/sh /etc/rc.common
# 热点省电 (Hotspot Power Saver): the hotspotdata info screen app's background service
# (/etc/e5-infoscreen/plugins/hotspotdata/service.sh), and its deep sleep
# (sleep.sh, instance "sleep").  Installed by the app's backend; it removes
# itself when the app is removed.
START=99
USE_PROCD=1

SCRIPT=/etc/e5-infoscreen/plugins/hotspotdata/service.sh
SLEEP=/etc/e5-infoscreen/plugins/hotspotdata/sleep.sh

start_service() {
	[ -f "$SCRIPT" ] || return 0
	procd_open_instance
	procd_set_param command /bin/sh "$SCRIPT"
	procd_set_param respawn 3600 5 0
	procd_close_instance
	[ -f "$SLEEP" ] || return 0
	procd_open_instance sleep
	procd_set_param command /bin/sh "$SLEEP"
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
